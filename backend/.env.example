# ORCA Marine AI - Backend Environment Template

# AI & LLM Service Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Sarvam AI Indic Speech & Translation (Saaras STT, Bulbul TTS, NMT)
SARVAM_API_KEY=your_sarvam_api_key_here

# Production Database (PostgreSQL)
# Render format: postgresql://orca_user:password@host:5432/orca_marine
# Local dev defaults to SQLite (orca_dev.db) if unset
DATABASE_URL=postgresql://orca_user:password@localhost:5432/orca_marine

# Distributed Cache (Redis)
# Local dev falls back to in-memory low-bandwidth geospatial cache if unset
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
JWT_SECRET=generate_a_secure_random_64_character_secret_key_here
JWT_EXPIRY_SECONDS=604800

# Authoritative Ocean Data Providers
INCOIS_BASE_URL=https://incois.gov.in
INCOIS_TIMEOUT_SEC=4.0
