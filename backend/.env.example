# ORCA Marine AI Backend Environment Configuration Template
# Copy to backend/.env locally or configure in Render -> Environment.
# Never commit real secrets to git.

# Core Runtime, Database & Cache
APP_ENV=development
PYTHON_VERSION=3.11.11
JWT_SECRET=
JWT_SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///orca_dev.db
REDIS_URL=
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:5173

# Core AI & Multilingual Providers
GEMINI_API_KEY=
LANGUAGE_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_BASE_URL=
SARVAM_TIMEOUT_SEC=15
BHASHINI_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_USER_ID=

# Marine Telemetry, Tides & Satellite Context
INCOIS_BASE_URL=https://incois.gov.in
INCOIS_TIMEOUT_SEC=15
STORMGLASS_API_KEY=
WORLDTIDES_API_KEY=
EARTH_ENGINE_PROJECT=
MOSDAC_ENABLE_RASTER_SAMPLING=false
MOSDAC_DATA_DIR=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# Google Sign-In
GOOGLE_CLIENT_ID=

# SMS Gateway (Pick ONE: Twilio, MSG91, or Webhook)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be ONLY your single Twilio sender number (e.g. +15005550006), NOT recipient numbers:
TWILIO_FROM_NUMBER=
# Comma-separated phone numbers that receive SOS alert SMS messages (e.g. +919876543210):
SOS_ALERT_RECIPIENTS=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=ORCAMR
MSG91_TEMPLATE_ID=

SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Email SMTP Gateway (For password resets; with Gmail App Password, SMTP_USER and SMTP_FROM must match your Gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=true

# Web Push VAPID Keys (generate locally via: npx --yes web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
