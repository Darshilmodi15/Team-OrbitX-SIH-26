# ORCA Marine AI - Backend Environment Template

# AI & LLM Service Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Sarvam AI Indic Speech & Translation (Saaras STT, Bulbul TTS, NMT)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TIMEOUT_SEC=5

# Bhashini AI Services (MeitY ULCA / Dhruva)
# From Bhashini Dashboard -> Your API Keys card (orca_marine_ai):
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_udyat_key_here                # UDYAT KEY from dashboard (ulcaApiKey)
BHASHINI_INFERENCE_API_KEY=your_inference_key_here  # INFERENCE key from dashboard
BHASHINI_PIPELINE_ID=64392f96daac500b55c543d6       # Default pipeline ID

# Production Database (PostgreSQL)
# Render format: postgresql://orca_user:password@host:5432/orca_marine
# Local dev defaults to SQLite (orca_dev.db) if unset
DATABASE_URL=postgresql://orca_user:password@localhost:5432/orca_marine

# Distributed Cache (Redis)
# Local dev falls back to in-memory low-bandwidth geospatial cache if unset
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication (server side only)
APP_ENV=development
JWT_SECRET_KEY=provide_a_cryptographically_random_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173

# Google sign-in remains disabled until backend ID-token verification is implemented.
GOOGLE_CLIENT_ID=

# Authoritative Ocean Data Providers
INCOIS_BASE_URL=https://incois.gov.in
INCOIS_TIMEOUT_SEC=4.0
